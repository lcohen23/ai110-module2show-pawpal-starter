classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +edit_task(task: Task, changes: dict) None
        +remove_task(task: Task) None
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +str priority
        +str frequency
        +str preferred_time
        +bool completed
        +str pet_name
        +mark_complete() None
        +reset_for_next_occurrence() None
    }

    class ScheduledTask {
        +Task task
        +str start_time
    }

    class Scheduler {
        +Owner owner
        +str day_start
        +list~ScheduledTask~ plan
        +list~Task~ skipped_tasks
        +collect_tasks() list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +generate_plan() list~ScheduledTask~
        +detect_conflicts() list~str~
        +explain_plan() str
    }

    Owner "1" o-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : schedules
    Scheduler "1" *-- "0..*" ScheduledTask : produces
    ScheduledTask "0..*" --> "1" Task : places
